# O contexto de build precisa ser pequeno: o repositório tem 600 MB de dados
# brutos e histórico que a imagem não usa.
.git
.pytest_cache
__pycache__
*.pyc
dados/bruto
dados/pacote
dados/processado
dados/externo
saidas
notebooks
testes
docs
src
app
site
*.html
*.md

# Reabre o que o Dockerfile realmente copia.
!site/index.html
!site/estilo.css
!site/app.js
!src/vigia/exportar_site.py
!dados/processado/painel.csv
!dados/externo/malha_ride_df.geojson
!dados/externo/malha_ras_df.geojson
!dados/externo/vulnerabilidade_ras.csv
!saidas/desempenho_modelos.csv
!saidas/alarmes.json
!saidas/clima_futuro.json
!saidas/alerta.json
!docs/dicionario_de_dados.csv
!docs/glossario.csv
