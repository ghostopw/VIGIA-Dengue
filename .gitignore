__pycache__/
*.pyc
.venv/
.streamlit/secrets.toml

# Intermediarios reproduziveis pelos scripts (o pacote final e versionado).
dados/bruto/
# Com /*, e nao com a pasta inteira: o git nao reabre arquivo dentro de pasta
# ignorada, e as excecoes la embaixo ficariam sem efeito.
dados/processado/*
dados/vigia_dengue_dados.zip
saidas/figuras/*.png

# Estado do alerta, reescrito a cada ciclo de atualizacao.
saidas/alerta.json
saidas/alerta.txt

# Malha bruta dos setores: 6 MB baixaveis do FTP do IBGE. O que o painel
# usa e o setores_df.geojson derivado, esse sim versionado.
dados/externo/DF_setores_CD2022.gpkg

# Exceções para a publicação do painel.
#
# `dados/processado/` e `alerta.json` continuam fora do git como regra: são
# gerados pelo pipeline e somam centenas de megabytes. Estes dois arquivos,
# porém, são o que o painel publicado lê em tempo de execução, e a imagem é
# construída no GitHub Actions, que só enxerga o que está versionado.
!dados/processado/painel.csv
!saidas/alerta.json

# A série bruta do território, que o ciclo diário (atualizar-dados.yml)
# completa com as semanas recentes. Fica no git porque o GitHub Actions não
# guarda nada de uma execução para a outra.
!dados/processado/infodengue_territorio.csv
